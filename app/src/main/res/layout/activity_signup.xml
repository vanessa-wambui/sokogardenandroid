<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6161EB"
    android:orientation="vertical"
    tools:context=".SignupActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Signup"
        android:textAlignment="center"
        android:textColor="#F5000000"
        android:textSize="38sp"
        android:textStyle="bold|italic"
        android:background="@drawable/shape"
        android:padding="12dp"/>
<!--    below is a cardview-->

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="10dp"
        android:layout_margin="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

<!--            below is the edit text for username-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="👤 Enter your Username"
                android:textColorHint="#000"
                android:textSize="23sp"
                android:textColor="#565"
                android:id="@+id/username"
                android:layout_margin="8dp"
                android:background="#898"
                android:padding="10dp" />
            <!--            below is the edit text for email-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="📧 Enter your Email Address"
                android:textColorHint="#000"
                android:textSize="23sp"
                android:textColor="#565"
                android:id="@+id/email"
                android:layout_margin="8dp"
                android:background="#898"
                android:padding="10dp"
                android:inputType="textEmailAddress"/>

            <!--            below is the edit text for username-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="🔑 Enter your Password"
                android:textColorHint="#000"
                android:textSize="23sp"
                android:textColor="#565"
                android:id="@+id/password"
                android:layout_margin="8dp"
                android:background="#898"
                android:padding="10dp"
                android:inputType="textPassword" />

            <!--            below is the edit text for phone-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="📞 Enter your Phone Number"
                android:textColorHint="#000"
                android:textSize="23sp"
                android:textColor="#565"
                android:id="@+id/phone"
                android:layout_margin="8dp"
                android:background="#898"
                android:padding="10dp"
                android:inputType="number"/>

<!--            below is the sign up button-->
            <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 Signup"
            android:textSize="25sp"
            android:padding="20dp"
            android:layout_marginLeft="100dp"
            android:layout_marginTop="20dp"
            android:textColor="#E1CDD8"
            android:backgroundTint="#051232"
            android:id="@+id/signupBtn" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already Have an Account? Signin"
                android:textAlignment="center"
                android:textSize="23sp"
                android:layout_marginTop="25dp"
                android:textColor="#0013e9"
                android:id="@+id/signintxt" />


        </LinearLayout>

    </androidx.cardview.widget.CardView>



</LinearLayout>